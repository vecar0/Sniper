{
  "name": "long-shot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LONG SHOT - 장거리 저격 훈련 시뮬레이터 (3D 브라우저 게임)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
