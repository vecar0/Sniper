    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.2",
    "@types/three": "0.170.0",
    "typescript": "5.7.3",
    "vite": "6.2.0",
    "vitest": "3.0.5"
  }
}
